# Included inside firewall4's table inet fw4.
set ios_enabled_v4 {
    type ipv4_addr;
    flags interval;
}
set ios_enabled_v6 {
    type ipv6_addr;
    flags interval;
}
set ios_enabled_mac {
    type ether_addr;
}
set ios_enabled_mac_v6 {
    type ether_addr;
}
set ios_block_v6 {
    type ipv6_addr;
    flags interval;
}
set ios_block_mac_v6 {
    type ether_addr;
}
set ios_monitored_v4 {
    type ipv4_addr;
}
set ios_monitored_v6 {
    type ipv6_addr;
}
set ios_monitored_mac {
    type ether_addr;
}
set ios_online_v4 {
    type ipv4_addr;
    flags timeout;
    timeout 30m;
}
set ios_online_v6 {
    type ipv6_addr;
    flags timeout;
    timeout 30m;
}
set ios_online_mac {
    type ether_addr;
    flags timeout;
    timeout 30m;
}
set ios_target_v4 {
    type ipv4_addr;
    flags interval, timeout;
    timeout 1h;
}
set ios_target_v6 {
    type ipv6_addr;
    flags interval, timeout;
    timeout 1h;
}
set ios_lan_ifaces {
    type ifname;
    elements = { "br-lan" };
}

chain ios_device_activity {
    type filter hook prerouting priority -140; policy accept;
    iifname @ios_lan_ifaces ether saddr @ios_monitored_mac update @ios_online_mac { ether saddr timeout 30m }
    iifname @ios_lan_ifaces ip saddr @ios_monitored_v4 update @ios_online_v4 { ip saddr timeout 30m }
    iifname @ios_lan_ifaces ip6 saddr @ios_monitored_v6 update @ios_online_v6 { ip6 saddr timeout 30m }
}

chain ios_quic_guard {
    type filter hook prerouting priority -120; policy accept;
    iifname @ios_lan_ifaces ether saddr @ios_enabled_mac ip daddr @ios_target_v4 udp dport 443 drop
    iifname @ios_lan_ifaces ether saddr @ios_enabled_mac_v6 ip6 daddr @ios_target_v6 udp dport 443 drop
    iifname @ios_lan_ifaces ip saddr @ios_enabled_v4 ip daddr @ios_target_v4 udp dport 443 drop
    iifname @ios_lan_ifaces ip6 saddr @ios_enabled_v6 ip6 daddr @ios_target_v6 udp dport 443 drop
    iifname @ios_lan_ifaces ip6 saddr @ios_block_v6 drop
    iifname @ios_lan_ifaces ether saddr @ios_block_mac_v6 ip6 saddr != :: drop
}
chain ios_tls_redirect {
    type nat hook prerouting priority -110; policy accept;
    iifname @ios_lan_ifaces ether saddr @ios_enabled_mac ip daddr @ios_target_v4 tcp dport 443 redirect to :10443
    iifname @ios_lan_ifaces ether saddr @ios_enabled_mac_v6 ip6 daddr @ios_target_v6 tcp dport 443 redirect to :10443
    iifname @ios_lan_ifaces ip saddr @ios_enabled_v4 ip daddr @ios_target_v4 tcp dport 443 redirect to :10443
    iifname @ios_lan_ifaces ip6 saddr @ios_enabled_v6 ip6 daddr @ios_target_v6 tcp dport 443 redirect to :10443
}
chain ios_input_guard {
    type filter hook input priority -5; policy accept;
    ct status dnat tcp dport 10443 accept
    tcp dport 10443 iifname != "lo" reject with tcp reset
    tcp dport 10445 iifname @ios_lan_ifaces accept
    tcp dport 10445 reject with tcp reset
}
